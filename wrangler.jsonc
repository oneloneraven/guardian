// Bindings are repeated in every environment: an environment that omits one does not inherit it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardian",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guardian",
      "database_id": "bdaeb3d5-53e9-4fe4-9a0e-7d6c8aee8b05",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production",
        "ACCESS_TEAM_DOMAIN": "ravendarque.cloudflareaccess.com",
        "ACCESS_AUD": "f5e21a9a1a1f89eb5759a7e61125d529732a4a783e6ab8f9adb69689c49f1dd7",
        "ADMIN_HOST": "guardian.oneloneraven.com"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "guardian",
          "database_id": "bdaeb3d5-53e9-4fe4-9a0e-7d6c8aee8b05",
          "migrations_dir": "migrations"
        }
      ],
      "routes": [
        {
          "pattern": "guardian-api.oneloneraven.com/*",
          "zone_name": "oneloneraven.com"
        },
        {
          "pattern": "guardian.oneloneraven.com/*",
          "zone_name": "oneloneraven.com"
        }
      ]
    },
    "preview": {
      "vars": {
        "APP_ENV": "preview"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "guardian-preview",
          "database_id": "",
          "migrations_dir": "migrations"
        }
      ],
      "workers_dev": true,
      "preview_urls": true,
      "previews": {
        "vars": {
          "APP_ENV": "preview"
        },
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "guardian-preview",
            "database_id": "",
            "migrations_dir": "migrations"
          }
        ]
      }
    },
    "e2e": {
      "vars": {
        "APP_ENV": "e2e",
        "ADMIN_ACCESS_CHECK": "off"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "guardian",
          "database_id": "bdaeb3d5-53e9-4fe4-9a0e-7d6c8aee8b05",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
